[Unit]
Description=Furnace experiment controller on Raspberry Pi
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/furnacepi
ExecStart=/opt/furnacepi/.venv/bin/python -m furnacepi.main --config /etc/furnacepi/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
